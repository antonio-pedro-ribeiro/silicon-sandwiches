Size=11;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="560" height="80" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Cor = componente do kata&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="300" height="20" as="geometry"/></mxCell><mxCell id="c43" value="CatalogCheckout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDE68A;strokeColor=#B45309;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="736" width="140" height="30" as="geometry"/></mxCell><mxCell id="c44" value="Location" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="736" width="140" height="30" as="geometry"/></mxCell><mxCell id="c45" value="Promotion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBCFE8;strokeColor=#BE185D;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="736" width="140" height="30" as="geometry"/></mxCell><mxCell id="c46" value="ManageInventory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BBF7D0;strokeColor=#15803D;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="736" width="140" height="30" as="geometry"/></mxCell><mxCell id="c47" value="MakeOrder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FED7AA;strokeColor=#C2410C;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="736" width="140" height="30" as="geometry"/></mxCell><mxCell id="c48" value="Delivery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DDD6FE;strokeColor=#6D28D9;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="736" width="140" height="30" as="geometry"/></mxCell><mxCell id="c49" value="Recipes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#A5F3FC;strokeColor=#0