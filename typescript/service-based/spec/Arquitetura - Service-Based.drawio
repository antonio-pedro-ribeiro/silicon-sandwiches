m FK: 12&lt;br&gt;&lt;br&gt;Uma partição não é um componente: &lt;code&gt;recipe_ingredient&lt;/code&gt; (Recipes) está na partição inventory e &lt;code&gt;promotion_*&lt;/code&gt; na partição orders, porque andam com o serviço que as usa.&lt;br&gt;&lt;br&gt;A partição kitchen é usada por kitchen-entities, que o Orders e o Kitchen importam." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FEF9C3;strokeColor=#A16207;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="100" width="360" height="220" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Cor = componente do kata&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="300" height="20" as="geometry"/></mxCell><mxCell id="c43" value="CatalogCheckout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDE68A;strokeColor=#B45309;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="140" height="30" as="geometry"/></mxCell><mxCell id="c44" value="Location" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="716" width="140" height="30" as="geometry"/></mxCell><mxCell id="c45" value="Promotion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBCFE8;strokeColor=#BE185D;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="716" width="140" height="30" as="geometry"/></mxCell><mxCell id="c46" value="ManageInventory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BBF7D0;strokeColor=#15803D;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="716" width="140" height="30" as="geometry"/></mxCell><mxCell id="c47" value="MakeOrder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FED7AA;strokeColor=#C2410C;fontColor=#111111;