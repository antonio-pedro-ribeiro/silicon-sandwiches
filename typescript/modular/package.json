{
  "name": "silicon-sandwiches-modular-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Kata Silicon Sandwiches com particionamento por domínio (estilo Modular Monolith). Só o checkout está implementado; os restantes módulos são mocks. Versão em TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test",
    "check:arch": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-modules.ts",
    "reset:db": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/reset-db.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.3"
  }
}
