parent="1" source="c2" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="Fora da classe ficam só os testes (&lt;code&gt;test/checkout.test.ts&lt;/code&gt;, os 9 de sempre) e &lt;code&gt;scripts/check-mud.ts&lt;/code&gt;.&lt;br&gt;&lt;br&gt;Os quadrados à direita de cada parte são os componentes do kata em que ela mexe." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FEF9C3;strokeColor=#A16207;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="480" width="360" height="120" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Cor = componente do kata&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="300" height="20" as="geometry"/></mxCell><mxCell id="c57" value="CatalogCheckout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDE68A;strokeColor=#B45309;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="140" height="30" as="geometry"/></mxCell><mxCell id="c58" value="Location" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="806" width="140" height="30" as="geometry"/></mxCell><mxCell id="c59" value="Promotion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBCFE8;strokeColor=#BE185D;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="806" width="140" height="30" as="geometry"/></mxCell><mxCell id="c60" value="ManageInventory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BBF7D0;strokeColor=#15803D;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="806" width="140" height="30" as="geometry"/></mxCell><mxCell id="c61" value="MakeOrder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FED7AA;strokeColor=