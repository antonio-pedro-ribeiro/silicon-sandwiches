<mxfile host="drawio" version="24.7.17"><diagram id="p1" name="1 · Particionamento de topo"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="src/core/ · o núcleo (o caminho feliz)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#4B5563;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#111111;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1120" height="520" as="geometry"/></mxCell><mxCell id="c4" value="modules/ · os sete módulos do modular/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#4B5563;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#111111;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1080" height="230" as="geometry"/></mxCell><mxCell id="c15" value="src/plugins/ · os plug-ins" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#4B5563;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#111111;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1220" y="150" width="480" height="520" as="geometry"/></mxCell><mxCell id="c16" value="store/ · contrato store" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#1D4ED8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=11;fontColor=#1D4ED8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1240" y="190" width="440" height="150" as="geometry"/></mxCell><mxCell id="c19" value="promotion/ · contrato promotion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#BE185D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=11;fontColor=#BE185D;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1240" y="360" width="440" height="200" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Microkernel · núcleo + plug-ins&lt;/b&gt;&lt;br&gt;O núcleo faz o caminho feliz e é, por dentro, o monólito modular. Os plug-ins isolam o que muda muito: o menu e as entregas de cada loja, a regra de cada código. Só app.ts conhece os dois lados." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="56" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;app.ts&lt;/b&gt; · raiz de composição: cria o registo de plug-ins e os módulos do núcleo, e liga-os · &lt;b&gt;server.ts&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E5E7EB;strokeColor=#4B5563;fontColor=#111111;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1660" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;catalogcheckout/&lt;/b&gt;&lt;br&gt;&lt;br&gt;menu = catálogo comum + plug-in da loja&lt;br&gt;&lt;i&gt;sem checkout_store_menu&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;index.ts · presentation/ · business/ · persistence/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDE68A;strokeColor=#B45309;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="75" y="225" width="142" height="175" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;location/&lt;/b&gt;&lt;br&gt;&lt;br&gt;getStore&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4B5563&quot;&gt;index.ts · presentation/ · business/ · persistence/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontColor=#111111;fontSize=11;" vertex="1" parent="1"><mxGeometry x="227" y="225" width="142" height="175" as="geometry"/></mxCell><mxCell id="c7" 